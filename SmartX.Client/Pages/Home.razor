@page "/gateway"
@inject SmartX.Client.Services.AuthState Auth
@inject NavigationManager Nav

<div style="padding:30px 40px;">
    <div class="section-label">CONTROL PLANE · SELECT A MODULE</div>
    <h1 style="margin:6px 0;">Three architectural pillars</h1>
    <p style="color:var(--text-dim);max-width:640px;">The Smart-X gateway is delivered in three stages. Part 1 activates telemetry ingestion. The command stream and mesh-routing modules stay locked until later builds.</p>

    <div class="pillar-menu">
        <NavLink class="pillar" href="/ingestion">
            <div class="pillar-icon">📡</div>
            <h3>Sensor Data Ingestion &amp; Telemetry</h3>
            <p style="color:var(--text-dim);font-size:13px;">Register nodes, push typed telemetry through the API, validate deployment trees and attach device logs.</p>
            <span class="pillar-tag live">● LIVE · PART 1</span>
        </NavLink>

        <div class="pillar disabled">
            <div class="pillar-icon">⏱</div>
            <h3>Real-Time Command Stream &amp; History</h3>
            <p style="color:var(--text-dim);font-size:13px;">Push commands to actuators and replay historical event streams across the mesh.</p>
            <span class="pillar-tag disabled-tag">🔒 DISABLED · PART 2</span>
        </div>

        <div class="pillar disabled">
            <div class="pillar-icon">🕸</div>
            <h3>Network Topology &amp; Mesh Routing</h3>
            <p style="color:var(--text-dim);font-size:13px;">Visualise the node mesh and compute optimal routing paths between gateways.</p>
            <span class="pillar-tag disabled-tag">🔒 DISABLED · FINAL POE</span>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/", replace: true);
        }
    }
}