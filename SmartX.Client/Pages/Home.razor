@page "/gateway"
@inject SmartX.Client.Services.AuthState Auth
@inject NavigationManager Nav

<h1>Smart-X IoT Mesh Gateway</h1>
<p>Choose an architectural pillar below.</p>

<div class="pillar-menu">
    <NavLink class="pillar" href="/ingestion">
        <h3> Sensor Data Ingestion &amp; Telemetry</h3>
        <p>Register sensors, upload configs/logs, and watch live telemetry with anomaly alerts.</p>
    </NavLink>

    <div class="pillar disabled" title="Coming in Part 2 of the PoE">
        <h3> Real-Time Command Stream &amp; History</h3>
        <p>Disabled — to be implemented in Part 2 of the PoE.</p>
    </div>

    <div class="pillar disabled" title="Coming in the final PoE">
        <h3> Network Topology &amp; Mesh Routing</h3>
        <p>Disabled — to be implemented in the final PoE.</p>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/", replace: true);
        }
    }
}