@page "/"
@inject FirebaseAuthService FirebaseAuth
@inject SmartX.Client.Services.AuthState Auth
@inject NavigationManager Nav

<div class="login-card">
    <h1>Sign in to the gateway</h1>
    <p class="sub">Authenticate to reach the Smart-X control plane.</p>

    <EditForm Model="_credentials" OnValidSubmit="HandleLogin">
        <input @bind="_credentials.Email" placeholder="Email" />
        <input @bind="_credentials.Password" type="password" placeholder="Password" />
        <button type="submit" class="primary">Sign in with Firebase</button>
    </EditForm>
    <button class="guest" @onclick="ContinueAsGuest">Continue as Guest</button>

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="error">@_error</p>
    }
</div>

@code {
    private LoginModel _credentials = new();
    private string _error = string.Empty;

    private async Task HandleLogin()
    {
        var result = await FirebaseAuth.SignInAsync(_credentials.Email, _credentials.Password);
        if (result is not null)
        {
            Auth.SignIn(result.Email, result.IdToken);
            Nav.NavigateTo("/gateway");
        }
        else
        {
            _error = "Invalid email or password.";
        }
    }

    private void ContinueAsGuest()
    {
        Auth.SignIn("Guest", asGuest: true);
        Nav.NavigateTo("/gateway");
    }

    private class LoginModel
    {
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
    }
}