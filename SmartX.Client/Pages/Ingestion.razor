@page "/ingestion"
@using Microsoft.AspNetCore.SignalR.Client
@inject ApiClient Api
@inject SmartX.Client.Services.AuthState Auth
@inject NavigationManager Nav
@implements IAsyncDisposable

<h1>Sensor Data Ingestion &amp; Telemetry</h1>

<div class="section-card">
    <h3>Register a Sensor</h3>
    <EditForm Model="_newSensor" OnValidSubmit="RegisterSensorAsync">
        <div class="reg-form">
            <input @bind="_newSensor.MacAddress" placeholder="Device MAC (AA:BB:CC:00:00:0X)" required />
            <input @bind="_newSensor.Location" placeholder="Zone / Room / Node ID" required />
            <select @bind="_newSensor.Category">
                <option value="Environmental">Environmental</option>
                <option value="Power Consumption">Power Consumption</option>
                <option value="Actuator">Actuator</option>
            </select>
            <InputFile OnChange="OnFileSelected" />
            <button type="submit">Register Sensor</button>
            <button type="button" @onclick="GenerateRandomSensor"> Generate Random Sensor</button>
        </div>
    </EditForm>
    @if (!string.IsNullOrEmpty(_registrationStatus))
    {
        <p><em>@_registrationStatus</em></p>
    }
</div>

<div class="section-card">
    <h3>Live Telemetry <span style="font-weight:normal;">(real-time via SignalR)</span></h3>
    <div class="sensor-grid">
        @foreach (var tile in _tiles.Values.OrderBy(t => t.SensorId))
        {
            <div class="sensor-tile @(tile.IsAnomaly ? "state-warning" : "state-normal")">
                <strong>@tile.SensorId</strong>
                <span>@tile.DisplayValue @tile.Unit</span>
            </div>
        }
    </div>

    <h4>Anomaly &amp; Event Feed</h4>
    <div class="alert-feed">
        @foreach (var msg in _alerts.TakeLast(15))
        {
            <div class="alert-toast">@msg</div>
        }
    </div>
</div>

<div class="section-card">
    <h3>Advanced OOP Demonstrations</h3>
    <button @onclick="LoadDemosAsync">Run Demos</button>

    @if (_deploymentResult is not null)
    {
        <p>
            <strong>Recursive deployment validation:</strong>
            @(_deploymentResult.IsValid ? "✅ All nodes valid" : $"❌ Invalid at: {_deploymentResult.FirstInvalidPath}")
        </p>
    }
    @if (_powerResult is not null)
    {
        <p>
            <strong>Operator overloading:</strong> @_powerResult.Meter1 + @_powerResult.Meter2 → @_powerResult.Aggregate
            (Δ = @_powerResult.Delta W)
        </p>
    }
    @if (_soilHistory is not null)
    {
        <ul>
            @foreach (var s in _soilHistory)
            {
                <li>@s.Sensor: [@string.Join(", ", s.Readings)] — avg @s.Average</li>
            }
        </ul>
    }
</div>

@code {
    private static readonly System.Text.RegularExpressions.Regex MacPattern =
        new(@"^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$");
    private readonly Random _rng = new();

    private SensorRegistration _newSensor = new() { Category = "Environmental" };
    private string _registrationStatus = string.Empty;
    private IReadOnlyList<Microsoft.AspNetCore.Components.Forms.IBrowserFile>? _selectedFiles;

    private HubConnection? _hub;
    private readonly Dictionary<string, TileState> _tiles = new();
    private readonly List<string> _alerts = new();

    private DeploymentValidationResult? _deploymentResult;
    private PowerAggregateResult? _powerResult;
    private List<SoilBatchSummary>? _soilHistory;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo("/", replace: true);
            return;
        }

        // Same port as Program.cs — the API's HTTPS port from Step 5.
        _hub = new HubConnectionBuilder()
            .WithUrl("https://localhost:7170/hubs/telemetry")
            .WithAutomaticReconnect()
            .Build();

        _hub.On<TelemetryBroadcast>("TelemetryReceived", broadcast =>
        {
            _tiles[broadcast.SensorId] = new TileState(broadcast.SensorId, broadcast.DisplayValue, broadcast.Unit, broadcast.IsAnomaly);
            if (broadcast.IsAnomaly)
                _alerts.Add($"⚠ {broadcast.Timestamp:T} — {broadcast.SensorId} anomaly: {broadcast.DisplayValue}{broadcast.Unit}");
            InvokeAsync(StateHasChanged);
        });

        await _hub.StartAsync();
    }

    private async Task RegisterSensorAsync()
    {
        if (!MacPattern.IsMatch(_newSensor.MacAddress))
        {
            _registrationStatus = "MAC address must be in the format AA:BB:CC:DD:EE:FF.";
            return;
        }

        bool ok = await Api.RegisterSensorAsync(_newSensor);
        if (ok && _selectedFiles is not null) await Api.UploadAttachmentAsync(_newSensor.MacAddress, _selectedFiles);

        _registrationStatus = ok ? $"Sensor {_newSensor.MacAddress} registered." : "Registration failed — check the API is running.";
        _newSensor = new SensorRegistration { Category = "Environmental" };
        _selectedFiles = null;
    }

    private void GenerateRandomSensor()
    {
        byte[] mac = new byte[6];
        _rng.NextBytes(mac);
        _newSensor.MacAddress = string.Join(":", mac.Select(b => b.ToString("X2")));
        _newSensor.Location = $"Zone {_rng.Next(1, 5)} / Node {_rng.Next(10, 99)}";
    }

    private void OnFileSelected(InputFileChangeEventArgs e) => _selectedFiles = e.GetMultipleFiles(maximumFileCount: 1);

    private async Task LoadDemosAsync()
    {
        _deploymentResult = await Api.GetDeploymentValidationAsync();
        _powerResult = await Api.GetPowerAggregateAsync();
        _soilHistory = await Api.GetSoilHistoryAsync();
    }

    public async ValueTask DisposeAsync() { if (_hub is not null) await _hub.DisposeAsync(); }

    private record TileState(string SensorId, string DisplayValue, string Unit, bool IsAnomaly);
}